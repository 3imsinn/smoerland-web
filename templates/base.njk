<!doctype html>
<html lang="{{ site.language | escape }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page.title | escape }}{% if page.title != site.name %} · {{ site.name | escape }}{% endif %}</title>
    {% if page.description %}<meta name="description" content="{{ page.description | escape }}">{% endif %}
    {% if canonicalUrl %}<link rel="canonical" href="{{ canonicalUrl | escape }}">{% endif %}
    <meta property="og:title" content="{{ page.title | escape }}">
    {% if page.description %}<meta property="og:description" content="{{ page.description | escape }}">{% endif %}
    {% if canonicalUrl %}<meta property="og:url" content="{{ canonicalUrl | escape }}">{% endif %}
    <meta property="og:type" content="{% if page.template == 'book' %}book{% else %}website{% endif %}">
    <link rel="stylesheet" href="/assets/css/styles.css">
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/" aria-label="{{ site.name | escape }} – Startseite">
          <img class="logo" src="/assets/logo.svg" alt="{{ site.name | escape }}">
        </a>
        {% if navigation.length %}
          <nav aria-label="Hauptnavigation">
            <ul>
              {% for item in navigation %}
                <li><a href="{{ item.url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.title | escape }}</a></li>
              {% endfor %}
            </ul>
          </nav>
        {% endif %}
      </div>
    </header>

    <main>{% block content %}{% endblock %}</main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <img src="/assets/logo.svg" alt="{{ site.name | escape }}">
        <div class="footer-meta">
          <span>© {{ site.name | escape }}</span>
          {% if footerLinks.length %}
            <nav aria-label="Rechtliche Hinweise">
              <ul>
                {% for item in footerLinks %}<li><a href="{{ item.url }}">{{ item.title | escape }}</a></li>{% endfor %}
              </ul>
            </nav>
          {% endif %}
        </div>
      </div>
    </footer>
  </body>
</html>
